{
  "name": "signalk-grib-weather-provider",
  "version": "0.7.1",
  "description": "Signal K Weather API provider decoding immutable GRIB datasets from Forecast Dataset Provider",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "pretest": "npm run build",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-weather",
    "signalk",
    "weather",
    "grib",
    "grib2",
    "gfs",
    "forecast",
    "marine"
  ],
  "author": "Jean-Laurent Girod (@macjl)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macjl/signalk-grib-weather-provider.git"
  },
  "homepage": "https://github.com/macjl/signalk-grib-weather-provider#readme",
  "bugs": {
    "url": "https://github.com/macjl/signalk-grib-weather-provider/issues"
  },
  "files": [
    "dist/",
    "test/",
    "screenshots/",
    "README.md",
    "CHANGELOG.md",
    "docs/"
  ],
  "engines": {
    "node": ">=24"
  },
  "signalk-plugin-enabled-by-default": false,
  "signalk": {
    "displayName": "GRIB Weather Provider",
    "recommends": [
      "signalk-grib-downloader",
      "signalk-weather-map"
    ],
    "screenshots": [
      "./screenshots/grib-weather-provider.png"
    ],
    "requires": [
      "signalk-forecast-dataset-provider"
    ]
  },
  "peerDependencies": {
    "@signalk/server-api": ">=2.0.0"
  },
  "devDependencies": {
    "@signalk/server-api": "^2.25.0",
    "@types/node": "^26.1.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@meri-imperiumi/eccodes-wasm": "^2.48.2"
  }
}
